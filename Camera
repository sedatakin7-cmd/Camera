<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<meta name="mobile-web-app-capable" content="yes">
<title>Kamera</title>
<style>
:root { --sari: #ffd60a; }
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none; }
html, body { height: 100%; background: #000; color: #fff; font-family: -apple-system, "SF Pro Text", system-ui, sans-serif; overflow: hidden; touch-action: none; }
body { display: flex; flex-direction: column; height: 100dvh; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); }
button { background: none; border: none; color: inherit; font: inherit; cursor: pointer; }
svg { display: block; }

#ust { height: 52px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 16px; flex-shrink: 0; }
.ikon { height: 38px; min-width: 38px; border-radius: 19px; display: flex; align-items: center; justify-content: center; gap: 4px; }
#flasBtn { justify-self: start; }
#flasBtn .cizgi { display: none; }
#flasBtn.kapali .cizgi { display: block; }
#flasBtn.acik { color: var(--sari); }
#chevron svg { transition: transform .25s; }
#chevron.acik svg { transform: rotate(180deg); }
#sureBtn { justify-self: end; font-size: 14px; font-weight: 600; }
#sureBtn.aktif { color: var(--sari); }

#alan { flex: 1; min-height: 0; position: relative; display: flex; align-items: center; justify-content: center; }
#vizor { position: relative; overflow: hidden; background: #0d0d0d; transition: width .25s, height .25s; }
#video { width: 100%; height: 100%; object-fit: cover; transform-origin: center; }
#izgara { position: absolute; inset: 0; pointer-events: none; display: none; }
#izgara div { position: absolute; background: rgba(255,255,255,.35); }
#karartma { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
#odak { position: absolute; width: 74px; height: 74px; border: 1.5px solid var(--sari); pointer-events: none; opacity: 0; transform: translate(-50%,-50%) scale(1.35); transition: transform .2s, opacity .25s; }
#odak.goster { opacity: 1; transform: translate(-50%,-50%) scale(1); }
#damgaOn { position: absolute; right: calc(var(--k) * .045); bottom: calc(var(--k) * .04); font: 600 calc(var(--k) * .05) "Courier New", monospace; color: #ff8c1a; text-shadow: 0 0 6px rgba(255,120,0,.8); pointer-events: none; display: none; }
#sayac { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 110px; font-weight: 200; pointer-events: none; text-shadow: 0 0 24px rgba(0,0,0,.6); }
#hata { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; text-align: center; padding: 30px; font-size: 16px; line-height: 1.5; color: #ddd; }

#zoomlar { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; align-items: center; gap: 4px; padding: 4px; border-radius: 24px; background: rgba(0,0,0,.3); }
.zoom { width: 34px; height: 34px; border-radius: 50%; background: rgba(0,0,0,.45); font-size: 11px; font-weight: 600; display: flex; align-items: center; justify-content: center; transition: all .15s; }
.zoom.secili { width: 40px; height: 40px; color: var(--sari); font-size: 12px; }

#panel { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.82); padding: 8px 0 12px; transform: translateY(100%); opacity: 0; transition: all .25s; pointer-events: none; }
#panel.acik { transform: none; opacity: 1; pointer-events: auto; }
.satir { display: flex; align-items: center; gap: 8px; overflow-x: auto; padding: 7px 14px; scrollbar-width: none; touch-action: pan-x; }
.satir::-webkit-scrollbar { display: none; }
.etiket { flex-shrink: 0; width: 84px; font-size: 12px; color: #9a9a9f; text-transform: uppercase; letter-spacing: .5px; }
.secim { flex-shrink: 0; padding: 7px 13px; border-radius: 15px; background: #2c2c2e; font-size: 13px; }
.secim.secili { background: var(--sari); color: #000; font-weight: 600; }

#modlar { height: 42px; position: relative; overflow: hidden; flex-shrink: 0; }
#serit { position: absolute; top: 0; left: 0; height: 100%; display: flex; align-items: center; gap: 28px; transition: transform .25s; white-space: nowrap; }
.mod { font-size: 13px; font-weight: 600; letter-spacing: 1.3px; }
.mod.secili { color: var(--sari); }

#alt { height: 116px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 28px; flex-shrink: 0; }
#kucuk { justify-self: start; width: 52px; height: 52px; border-radius: 8px; background: #1c1c1e center/cover; }
#deklansor { width: 78px; height: 78px; border-radius: 50%; border: 4px solid #fff; display: flex; align-items: center; justify-content: center; }
#deklansor span { width: 64px; height: 64px; border-radius: 50%; background: #fff; transition: transform .1s; }
#deklansor:active span { transform: scale(.88); }
#cevir { justify-self: end; width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center; }
#cevir svg { transition: transform .4s; }

#ekranFlas { position: fixed; inset: 0; background: #fff; opacity: 0; pointer-events: none; z-index: 15; transition: opacity .15s; }

#galeri { position: fixed; inset: 0; background: #000; display: none; flex-direction: column; z-index: 20; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); }
#galeri.acik { display: flex; }
#gUst { height: 56px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 14px; }
#gGeri { justify-self: start; color: var(--sari); font-size: 17px; }
#gOrta { text-align: center; }
#gBaslik { font-size: 15px; font-weight: 600; }
#gAlt { font-size: 12px; color: #9a9a9f; }
#gSayac { justify-self: end; font-size: 13px; color: #9a9a9f; }
#gResim { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
#buyuk { max-width: 100%; max-height: 100%; object-fit: contain; }
#gAraclar { height: 64px; display: flex; justify-content: space-around; align-items: center; }
#gAraclar button { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; color: var(--sari); }
#gSil { color: #ff453a !important; }
</style>
</head>
<body>

<div id="ust">
  <button class="ikon kapali" id="flasBtn" aria-label="Flaş">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/><line class="cizgi" x1="3" y1="3" x2="21" y2="21"/></svg>
  </button>
  <button class="ikon" id="chevron" aria-label="Ayarlar">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6"/></svg>
  </button>
  <button class="ikon" id="sureBtn" aria-label="Zamanlayıcı">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/></svg>
    <span id="sureYazi"></span>
  </button>
</div>

<div id="alan">
  <div id="vizor">
    <video id="video" autoplay playsinline muted></video>
    <div id="izgara">
      <div style="left:33.33%;top:0;bottom:0;width:1px"></div>
      <div style="left:66.66%;top:0;bottom:0;width:1px"></div>
      <div style="top:33.33%;left:0;right:0;height:1px"></div>
      <div style="top:66.66%;left:0;right:0;height:1px"></div>
    </div>
    <div id="damgaOn"></div>
    <div id="karartma"></div>
    <div id="odak"></div>
    <div id="sayac"></div>
    <div id="hata"></div>
    <div id="zoomlar"></div>
  </div>
  <div id="panel"></div>
</div>

<div id="modlar"><div id="serit"></div></div>

<div id="alt">
  <button id="kucuk" aria-label="Fotoğraflar"></button>
  <button id="deklansor" aria-label="Fotoğraf çek"><span></span></button>
  <button id="cevir" aria-label="Kamerayı çevir">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 0-14.9-3.5M4 4v4h4M4 13a8 8 0 0 0 14.9 3.5M20 20v-4h-4"/></svg>
  </button>
</div>

<div id="ekranFlas"></div>

<div id="galeri">
  <div id="gUst">
    <button id="gGeri">‹ Kamera</button>
    <div id="gOrta"><div id="gBaslik"></div><div id="gAlt"></div></div>
    <div id="gSayac"></div>
  </div>
  <div id="gResim"><img id="buyuk" alt="Fotoğraf"></div>
  <div id="gAraclar">
    <button id="gPaylas" aria-label="Paylaş"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M7 8l5-5 5 5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg></button>
    <button id="gKaydet" aria-label="Kaydet"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M7 11l5 5 5-5M5 21h14"/></svg></button>
    <button id="gSil" aria-label="Sil"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg></button>
  </div>
</div>

<script>
const $ = id => document.getElementById(id);
const video = $('video'), vizor = $('vizor'), alan = $('alan');

const FILTRELER = [
  ['Orijinal', 'none'],
  ['Canlı', 'saturate(1.6) contrast(1.08)'],
  ['Sıcak', 'sepia(.25) saturate(1.35) hue-rotate(-8deg)'],
  ['Soğuk', 'saturate(1.1) hue-rotate(12deg) brightness(1.04)'],
  ['Dramatik', 'contrast(1.45) brightness(.92) saturate(.85)'],
  ['Siyah beyaz', 'grayscale(1) contrast(1.1)'],
  ['Sepya', 'sepia(.85)']
];
const CERCEVELER = [['Yok', 'yok'], ['Beyaz', 'beyaz'], ['Polaroid', 'polaroid'], ['Film', 'film'], ['Siyah', 'siyah']];
const MODLAR = [{ id: 'foto', ad: 'FOTOĞRAF' }, { id: 'kare', ad: 'KARE' }];
const SURELER = [0, 3, 10];

const durum = {
  yon: 'environment', modIndex: 0, filtre: 'none', cerceve: 'yok', sure: 0,
  damga: false, izgara: false, flas: false,
  zoom: 1, dijital: 1, hw: null, torch: false, akis: null, track: null, cekiliyor: false
};
let fotolar = [];
let gi = 0;
const panelGuncelleyiciler = [];

const bekle = ms => new Promise(r => setTimeout(r, ms));
const p2 = n => String(n).padStart(2, '0');

function ayarKaydet() {
  try {
    const { modIndex, filtre, cerceve, sure, damga, izgara, flas } = durum;
    localStorage.setItem('kameraAyar', JSON.stringify({ modIndex, filtre, cerceve, sure, damga, izgara, flas }));
  } catch (e) {}
}
function ayarYukle() {
  try { Object.assign(durum, JSON.parse(localStorage.getItem('kameraAyar') || '{}')); } catch (e) {}
}

function satir(baslik, secenekler, al, ver) {
  const s = document.createElement('div');
  s.className = 'satir';
  const e = document.createElement('span');
  e.className = 'etiket';
  e.textContent = baslik;
  s.appendChild(e);
  const butonlar = secenekler.map(([ad, deger]) => {
    const b = document.createElement('button');
    b.className = 'secim';
    b.textContent = ad;
    b.onclick = () => { ver(deger); arayuzGuncelle(); ayarKaydet(); };
    s.appendChild(b);
    return [b, deger];
  });
  panelGuncelleyiciler.push(() => butonlar.forEach(([b, d]) => b.classList.toggle('secili', d === al())));
  $('panel').appendChild(s);
}

function paneliKur() {
  satir('Zamanlayıcı', [['Kapalı', 0], ['3 sn', 3], ['10 sn', 10]], () => durum.sure, v => durum.sure = v);
  satir('Tarih', [['Kapalı', false], ['Açık', true]], () => durum.damga, v => durum.damga = v);
  satir('Izgara', [['Kapalı', false], ['Açık', true]], () => durum.izgara, v => durum.izgara = v);
  satir('Çerçeve', CERCEVELER, () => durum.cerceve, v => durum.cerceve = v);
  satir('Filtre', FILTRELER, () => durum.filtre, v => durum.filtre = v);
}

function arayuzGuncelle() {
  panelGuncelleyiciler.forEach(f => f());
  video.style.filter = durum.filtre;
  $('izgara').style.display = durum.izgara ? 'block' : 'none';
  $('damgaOn').style.display = durum.damga ? 'block' : 'none';
  $('damgaOn').textContent = damgaYazi();
  $('flasBtn').classList.toggle('kapali', !durum.flas);
  $('flasBtn').classList.toggle('acik', durum.flas);
  $('sureBtn').classList.toggle('aktif', durum.sure > 0);
  $('sureYazi').textContent = durum.sure ? durum.sure + 's' : '';
}

function modlariKur() {
  MODLAR.forEach((m, i) => {
    const b = document.createElement('button');
    b.className = 'mod';
    b.textContent = m.ad;
    b.onclick = () => modSec(i);
    $('serit').appendChild(b);
  });
}
function modSec(i) {
  durum.modIndex = Math.max(0, Math.min(MODLAR.length - 1, i));
  const butonlar = [...$('serit').children];
  butonlar.forEach((b, j) => b.classList.toggle('secili', j === durum.modIndex));
  const el = butonlar[durum.modIndex];
  const kaydir = $('modlar').clientWidth / 2 - (el.offsetLeft + el.offsetWidth / 2);
  $('serit').style.transform = `translateX(${kaydir}px)`;
  boyutla();
  ayarKaydet();
}
const kareMi = () => MODLAR[durum.modIndex].id === 'kare';

function boyutla() {
  const r = alan.getBoundingClientRect();
  const oran = kareMi() ? 1 : 3 / 4;
  let w = r.width, h = w / oran;
  if (h > r.height) { h = r.height; w = h * oran; }
  vizor.style.width = w + 'px';
  vizor.style.height = h + 'px';
  vizor.style.setProperty('--k', Math.min(w, h) + 'px');
}

async function kameraAc() {
  if (durum.akis) durum.akis.getTracks().forEach(t => t.stop());
  try {
    const akis = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: durum.yon }, width: { ideal: 3840 }, height: { ideal: 2160 } },
      audio: false
    });
    durum.akis = akis;
    durum.track = akis.getVideoTracks()[0];
    video.srcObject = akis;
    await video.play().catch(() => {});
    const caps = durum.track.getCapabilities ? durum.track.getCapabilities() : {};
    durum.hw = caps.zoom ? { min: caps.zoom.min, max: caps.zoom.max } : null;
    durum.torch = !!caps.torch;
    $('hata').style.display = 'none';
    zoomButonlariKur();
    zoomAyarla(1);
  } catch (e) {
    $('hata').style.display = 'flex';
    $('hata').textContent = 'Kamera açılamadı. Tarayıcıya kamera izni verdiğinizden ve sayfayı https:// ile başlayan bir adresten açtığınızdan emin olun.';
  }
}

function zoomButonlariKur() {
  const kutu = $('zoomlar');
  kutu.innerHTML = '';
  const degerler = (durum.hw && durum.hw.min <= 0.6) ? [0.5, 1, 2, 4] : [1, 2, 4];
  degerler.forEach(v => {
    const b = document.createElement('button');
    b.className = 'zoom';
    b.dataset.z = v;
    b.onclick = e => { e.stopPropagation(); zoomAyarla(v); };
    kutu.appendChild(b);
  });
}

function zoomYazi(z) {
  const t = Math.round(z * 10) / 10;
  return (t < 1 ? String(t).replace(/^0/, '') : String(t)).replace(/\.0$/, '');
}

function zoomAyarla(z) {
  const enAz = durum.hw ? Math.min(1, durum.hw.min) : 1;
  z = Math.min(10, Math.max(enAz, z));
  durum.zoom = z;
  let dijital = z;
  if (durum.hw) {
    const hwZ = Math.min(durum.hw.max, Math.max(durum.hw.min, z));
    dijital = Math.max(1, z / hwZ);
    durum.track.applyConstraints({ advanced: [{ zoom: hwZ }] }).catch(() => {});
  }
  durum.dijital = dijital;
  video.style.transform = (durum.yon === 'user' ? 'scaleX(-1) ' : '') + `scale(${dijital})`;
  const butonlar = [...$('zoomlar').children];
  let aktif = butonlar[0];
  butonlar.forEach(b => { if (+b.dataset.z <= z + 0.001) aktif = b; });
  butonlar.forEach(b => {
    const secili = b === aktif;
    b.classList.toggle('secili', secili);
    b.textContent = secili ? zoomYazi(z) + '×' : zoomYazi(+b.dataset.z);
  });
}

function odakla(x, y) {
  const r = vizor.getBoundingClientRect();
  const o = $('odak');
  o.style.left = (x - r.left) + 'px';
  o.style.top = (y - r.top) + 'px';
  o.classList.remove('goster');
  void o.offsetWidth;
  o.classList.add('goster');
  clearTimeout(odakla.t);
  odakla.t = setTimeout(() => o.classList.remove('goster'), 1200);
  if (durum.track) {
    durum.track.applyConstraints({ advanced: [{
      pointsOfInterest: [{ x: (x - r.left) / r.width, y: (y - r.top) / r.height }],
      focusMode: 'single-shot'
    }] }).catch(() => {});
  }
}

const mesafe = t => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
let pinch = null, dokunus = null;
vizor.addEventListener('touchstart', e => {
  if (e.touches.length === 2) { pinch = { d: mesafe(e.touches), z: durum.zoom }; dokunus = null; }
  else if (e.touches.length === 1 && !pinch) { dokunus = { x: e.touches[0].clientX, y: e.touches[0].clientY, hareket: false }; }
}, { passive: true });
vizor.addEventListener('touchmove', e => {
  if (pinch && e.touches.length === 2) zoomAyarla(pinch.z * mesafe(e.touches) / pinch.d);
  else if (dokunus) {
    const t = e.touches[0];
    if (Math.abs(t.clientX - dokunus.x) > 10 || Math.abs(t.clientY - dokunus.y) > 10) dokunus.hareket = true;
  }
}, { passive: true });
vizor.addEventListener('touchend', e => {
  if (pinch) { if (e.touches.length === 0) pinch = null; return; }
  if (!dokunus) return;
  const t = e.changedTouches[0];
  const dx = t.clientX - dokunus.x, dy = t.clientY - dokunus.y;
  if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) modSec(durum.modIndex + (dx < 0 ? 1 : -1));
  else if (!dokunus.hareket) odakla(t.clientX, t.clientY);
  dokunus = null;
});

function damgaYazi() {
  const d = new Date();
  return `'${String(d.getFullYear()).slice(2)} ${p2(d.getMonth() + 1)} ${p2(d.getDate())}`;
}
function damgaCiz(ctx, w, h) {
  const fs = Math.round(Math.min(w, h) * 0.05);
  ctx.font = `600 ${fs}px "Courier New", monospace`;
  ctx.textAlign = 'right';
  ctx.textBaseline = 'bottom';
  ctx.shadowColor = 'rgba(255,120,0,.8)';
  ctx.shadowBlur = fs * 0.35;
  ctx.fillStyle = '#ff8c1a';
  ctx.fillText(damgaYazi(), w - Math.min(w, h) * 0.045, h - Math.min(w, h) * 0.04);
  ctx.shadowBlur = 0;
}

function yuvarlak(ctx, x, y, w, h, r) {
  ctx.beginPath();
  if (ctx.roundRect) ctx.roundRect(x, y, w, h, r); else ctx.rect(x, y, w, h);
  ctx.fill();
}

function cerceveUygula(c) {
  const w = c.width, h = c.height, k = Math.min(w, h);
  let sol, sag, ust, alt, renk;
  switch (durum.cerceve) {
    case 'beyaz': sol = sag = ust = alt = k * 0.04; renk = '#ffffff'; break;
    case 'polaroid': sol = sag = ust = k * 0.06; alt = k * 0.24; renk = '#fbfaf5'; break;
    case 'siyah': sol = sag = ust = alt = k * 0.035; renk = '#000000'; break;
    case 'film': sol = sag = k * 0.03; ust = alt = k * 0.11; renk = '#111111'; break;
    default: return c;
  }
  const y = document.createElement('canvas');
  y.width = Math.round(w + sol + sag);
  y.height = Math.round(h + ust + alt);
  const x = y.getContext('2d');
  x.fillStyle = renk;
  x.fillRect(0, 0, y.width, y.height);
  x.drawImage(c, sol, ust);
  if (durum.cerceve === 'film') {
    x.fillStyle = '#e9e4d8';
    const dw = k * 0.035, dh = k * 0.05, ara = dw * 2.2;
    for (let px = ara / 2; px < y.width - dw; px += ara) {
      yuvarlak(x, px, (ust - dh) / 2, dw, dh, dw * 0.25);
      yuvarlak(x, px, y.height - alt + (alt - dh) / 2, dw, dh, dw * 0.25);
    }
  }
  if (durum.cerceve === 'polaroid') {
    x.fillStyle = '#555';
    x.font = `${Math.round(k * 0.05)}px "Segoe Print", "Bradley Hand", cursive`;
    x.textAlign = 'center';
    x.textBaseline = 'middle';
    x.fillText(new Date().toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }), y.width / 2, y.height - alt / 2);
  }
  return y;
}

function kareAl() {
  const vw = video.videoWidth, vh = video.videoHeight;
  const hedef = kareMi() ? 1 : 3 / 4;
  let sw, sh;
  if (vw / vh > hedef) { sh = vh; sw = vh * hedef; } else { sw = vw; sh = vw / hedef; }
  sw /= durum.dijital;
  sh /= durum.dijital;
  const sx = (vw - sw) / 2, sy = (vh - sh) / 2;
  const c = document.createElement('canvas');
  c.width = Math.round(sw);
  c.height = Math.round(sh);
  const ctx = c.getContext('2d');
  ctx.filter = durum.filtre;
  if (durum.yon === 'user') { ctx.translate(c.width, 0); ctx.scale(-1, 1); }
  ctx.drawImage(video, sx, sy, sw, sh, 0, 0, c.width, c.height);
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.filter = 'none';
  if (durum.damga) damgaCiz(ctx, c.width, c.height);
  return cerceveUygula(c);
}

function deklansorEfekti() {
  const k = $('karartma');
  k.style.transition = 'none';
  k.style.opacity = '1';
  void k.offsetWidth;
  k.style.transition = 'opacity .25s';
  k.style.opacity = '0';
  if (navigator.vibrate) navigator.vibrate(30);
}

async function cek() {
  if (durum.cekiliyor || !durum.track || !video.videoWidth) return;
  durum.cekiliyor = true;
  let torchAcik = false;
  try {
    for (let s = durum.sure; s > 0; s--) { $('sayac').textContent = s; await bekle(1000); }
    $('sayac').textContent = '';
    if (durum.flas) {
      if (durum.yon === 'environment' && durum.torch) {
        try { await durum.track.applyConstraints({ advanced: [{ torch: true }] }); torchAcik = true; await bekle(450); } catch (e) {}
      } else if (durum.yon === 'user') {
        $('ekranFlas').style.opacity = '1';
        await bekle(350);
      }
    }
    const foto = kareAl();
    if (torchAcik) durum.track.applyConstraints({ advanced: [{ torch: false }] }).catch(() => {});
    $('ekranFlas').style.opacity = '0';
    deklansorEfekti();
    const blob = await new Promise(r => foto.toBlob(r, 'image/jpeg', 0.93));
    const kayit = { id: Date.now(), tarih: Date.now(), blob };
    await dbEkle(kayit).catch(() => {});
    kayit.url = URL.createObjectURL(blob);
    fotolar.push(kayit);
    kucukResim();
  } finally {
    durum.cekiliyor = false;
  }
}

function kucukResim() {
  const son = fotolar[fotolar.length - 1];
  $('kucuk').style.backgroundImage = son ? `url(${son.url})` : 'none';
}

let db = null;
function dbAc() {
  return new Promise((res, rej) => {
    const r = indexedDB.open('kamera', 1);
    r.onupgradeneeded = () => r.result.createObjectStore('fotolar', { keyPath: 'id' });
    r.onsuccess = () => { db = r.result; res(); };
    r.onerror = () => rej(r.error);
  });
}
function dbIslem(mod, fn) {
  return new Promise((res, rej) => {
    if (!db) return rej();
    const tx = db.transaction('fotolar', mod);
    const istek = fn(tx.objectStore('fotolar'));
    tx.oncomplete = () => res(istek && istek.result);
    tx.onerror = () => rej(tx.error);
  });
}
const dbEkle = k => dbIslem('readwrite', s => s.put({ id: k.id, tarih: k.tarih, blob: k.blob }));
const dbSil = id => dbIslem('readwrite', s => s.delete(id));
const dbHepsi = () => dbIslem('readonly', s => s.getAll());

function galeriGoster() {
  const f = fotolar[gi];
  $('buyuk').src = f.url;
  const d = new Date(f.tarih);
  $('gBaslik').textContent = d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  $('gAlt').textContent = d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
  $('gSayac').textContent = (gi + 1) + ' / ' + fotolar.length;
}
$('kucuk').onclick = () => {
  if (!fotolar.length) return;
  gi = fotolar.length - 1;
  galeriGoster();
  $('galeri').classList.add('acik');
};
$('gGeri').onclick = () => $('galeri').classList.remove('acik');

let gDokunus = null;
$('gResim').addEventListener('touchstart', e => { gDokunus = e.touches[0].clientX; }, { passive: true });
$('gResim').addEventListener('touchend', e => {
  if (gDokunus === null) return;
  const dx = e.changedTouches[0].clientX - gDokunus;
  gDokunus = null;
  if (dx < -50 && gi < fotolar.length - 1) { gi++; galeriGoster(); }
  if (dx > 50 && gi > 0) { gi--; galeriGoster(); }
});

function dosyaAdi(f) {
  const d = new Date(f.tarih);
  return `IMG_${d.getFullYear()}${p2(d.getMonth() + 1)}${p2(d.getDate())}_${p2(d.getHours())}${p2(d.getMinutes())}${p2(d.getSeconds())}.jpg`;
}
$('gKaydet').onclick = () => {
  const f = fotolar[gi];
  const a = document.createElement('a');
  a.href = f.url;
  a.download = dosyaAdi(f);
  document.body.appendChild(a);
  a.click();
  a.remove();
};
$('gPaylas').onclick = async () => {
  const f = fotolar[gi];
  const dosya = new File([f.blob], dosyaAdi(f), { type: 'image/jpeg' });
  if (navigator.canShare && navigator.canShare({ files: [dosya] })) {
    try { await navigator.share({ files: [dosya] }); } catch (e) {}
  } else {
    alert('Paylaşım bu tarayıcıda desteklenmiyor. İndirme düğmesini kullanabilirsiniz.');
  }
};
$('gSil').onclick = async () => {
  if (!confirm('Bu fotoğraf silinsin mi?')) return;
  const f = fotolar[gi];
  await dbSil(f.id).catch(() => {});
  URL.revokeObjectURL(f.url);
  fotolar.splice(gi, 1);
  kucukResim();
  if (!fotolar.length) { $('galeri').classList.remove('acik'); return; }
  gi = Math.min(gi, fotolar.length - 1);
  galeriGoster();
};

$('deklansor').onclick = cek;
$('flasBtn').onclick = () => { durum.flas = !durum.flas; arayuzGuncelle(); ayarKaydet(); };
$('sureBtn').onclick = () => {
  durum.sure = SURELER[(SURELER.indexOf(durum.sure) + 1) % SURELER.length];
  arayuzGuncelle();
  ayarKaydet();
};
$('chevron').onclick = () => {
  $('chevron').classList.toggle('acik');
  $('panel').classList.toggle('acik');
};
let donus = 0;
$('cevir').onclick = () => {
  donus += 180;
  $('cevir').querySelector('svg').style.transform = `rotate(${donus}deg)`;
  durum.yon = durum.yon === 'environment' ? 'user' : 'environment';
  kameraAc();
};
document.addEventListener('keydown', e => {
  if (e.key === 'AudioVolumeUp' || e.key === 'AudioVolumeDown') { e.preventDefault(); cek(); }
});
document.addEventListener('visibilitychange', () => {
  if (document.hidden) { if (durum.akis) durum.akis.getTracks().forEach(t => t.stop()); durum.akis = null; durum.track = null; }
  else kameraAc();
});
window.addEventListener('resize', () => { boyutla(); modSec(durum.modIndex); });

ayarYukle();
paneliKur();
modlariKur();
arayuzGuncelle();
modSec(durum.modIndex);
dbAc()
  .then(dbHepsi)
  .then(liste => {
    fotolar = (liste || []).sort((a, b) => a.tarih - b.tarih).map(f => ({ ...f, url: URL.createObjectURL(f.blob) }));
    kucukResim();
  })
  .catch(() => {});
kameraAc();
</script>
